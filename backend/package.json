{
	"name": "backend",
	"version": "1.0.0",
	"main": "src/index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "node scripts/migrate-if-configured.js && node src/server.js",
		"seed": "node scripts/seed.js",
		"migrate": "knex migrate:latest",
		"migrate:rollback": "knex migrate:rollback",
		"typecheck": "tsc --noEmit",
		"test": "tap --node-arg=--import --node-arg=tsx --no-coverage -j1 \"test/worker-*.test.js\" \"test/security-*.test.js\""
	},
	"dependencies": {
		"@fastify/helmet": "^13.1.0",
		"@fastify/rate-limit": "^11.1.0",
		"@sentry/cloudflare": "^10.68.0",
		"@supabase/supabase-js": "^2.110.9",
		"bcryptjs": "^2.4.3",
		"hono": "^4.12.32",
		"jsonwebtoken": "^9.0.0",
		"knex": "^3.1.0",
		"pg": "^8.22.0",
		"zod": "^3.23.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260730.1",
		"@fastify/cors": "^11.3.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.20.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.10.0",
		"tap": "^16.3.10",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"wrangler": "^4.114.0"
	},
	"overrides": {
		"lodash": "^4.17.23",
		"ws": "^8.18.0",
		"shell-quote": "^1.8.4",
		"brace-expansion": "^1.1.11",
		"minimatch": "^3.1.2",
		"uuid": "^11.1.1",
		"@babel/core": "^7.26.10"
	}
}
