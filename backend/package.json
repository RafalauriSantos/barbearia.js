{
	"name": "backend",
	"version": "1.0.0",
	"main": "src/index.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "node scripts/migrate-if-configured.js && node src/server.js",
		"seed": "node scripts/seed.js",
		"migrate": "knex migrate:latest",
		"migrate:rollback": "knex migrate:rollback",
		"typecheck": "tsc --noEmit",
		"test": "tsx test/worker-runtime.test.js && tsx test/worker-rate-limiter.test.js && tsx test/security-headers.test.js && tsx test/security-improvements.test.js"
	},
	"dependencies": {
		"@fastify/helmet": "^13.1.0",
		"@fastify/rate-limit": "^11.1.0",
		"@sentry/cloudflare": "^10.68.0",
		"@supabase/supabase-js": "^2.110.9",
		"bcryptjs": "^2.4.3",
		"hono": "^4.12.34",
		"jsonwebtoken": "^9.0.0",
		"knex": "^3.1.0",
		"pg": "^8.22.0",
		"zod": "^3.23.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260730.1",
		"@fastify/cors": "^11.3.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.20.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.10.0",
		"tap": "^21.7.5",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"wrangler": "^4.114.0"
	}
}
