{
	"name": "vite_react_shadcn_js",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --open",
		"build": "vite build && node -e \"import('node:fs').then((fs) => fs.rmSync('.output', { recursive: true, force: true }))\"",
		"build:artifact": "vite build",
		"build:dev": "vite build --mode development",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e:smoke": "playwright test"
	},
	"dependencies": {
		"@sentry/react": "^10.68.0",
		"axios": "^1.18.1",
		"lucide-react": "^1.21.0",
		"react": "^18.3.1",
		"react-dom": "^19.2.8",
		"react-router-dom": "^6.30.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.32.0",
		"@playwright/test": "^1.61.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.0.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"autoprefixer": "^10.5.4",
		"eslint": "^9.32.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^15.15.0",
		"jsdom": "^20.0.3",
		"postcss": "^8.5.23",
		"tailwindcss": "^3.4.17",
		"typescript": "^7.0.2",
		"vite": "^5.4.21",
		"vitest": "^3.2.4"
	},
	"overrides": {
		"form-data": "4.0.6",
		"esbuild": "^0.25.0",
		"launch-editor": "^3.0.0",
		"@remix-run/router": "^1.23.2",
		"vite": "^5.4.21"
	}
}
